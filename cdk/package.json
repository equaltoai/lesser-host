    "constructs": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "aws-cdk": "^2.1122.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.6"
  }
}
