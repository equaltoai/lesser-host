# AppTheory v1.9.0's peerDependencies pin aws-cdk-lib to exact 2.254.0;
# but aws-cdk-lib 2.254.0 ships a bundled-dependency packaging bug
# (aws/aws-cdk#37949) that causes `npm ci` to fail with
# `Missing: jsonschema@1.4.1 from lock file` once any direct dependency
# is added to the lockfile. Fix is bumping aws-cdk-lib to >= 2.256.1.
#
# We honor the bump locally and disable strict peer-dep enforcement so
# the AppTheory peer-dep mismatch warns rather than fails. AppTheory's
# AppTheorySsrSite API surface is stable across this minor range — the
# warning is cosmetic. Tracking upstream issue at AppTheory; will revert
# this once they release v1.9.1 with the peerDep updated.
legacy-peer-deps=true
