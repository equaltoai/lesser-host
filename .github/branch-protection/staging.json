{
  "schema_version": "lesser-host.branch_protection_spec.v1",
  "repository": "equaltoai/lesser-host",
  "branch": "staging",
  "intent": "Integration branch for feature -> staging PRs. The existing Gov-infra rubric job is the required staging gate alongside the seven parallel CI jobs, and branches must be up to date before merge.",
  "policy": {
    "release_model": "feature -> staging -> main",
    "allowed_pr_sources": [
      "short-lived feature branches: aron/*, chore/*, codex/*, issue/*, feat/*, fix/*"
    ],
    "required_status_checks": [
      "go-test",
      "golangci-lint",
      "cdk-synth",
      "contracts-compile",
      "slither",
      "web-build",
      "contract-verify",
      "gov-rubric"
    ],
    "require_branches_up_to_date": true,
    "required_review": true,
    "direct_pushes": "blocked by required pull request rule with enforce_admins=true",
    "force_pushes": "blocked",
    "deletions": "blocked",
    "merge_owner": "reviewer/factory may merge feature -> staging PRs only under a per-session grant after required review and all eight required checks are green"
  },
  "github_branch_protection": {
    "method": "PUT",
    "endpoint": "/repos/equaltoai/lesser-host/branches/staging/protection",
    "payload": {
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "go-test",
          "golangci-lint",
          "cdk-synth",
          "contracts-compile",
          "slither",
          "web-build",
          "contract-verify",
          "gov-rubric"
        ]
      },
      "enforce_admins": true,
      "required_pull_request_reviews": {
        "dismissal_restrictions": {},
        "dismiss_stale_reviews": true,
        "require_code_owner_reviews": false,
        "required_approving_review_count": 1,
        "require_last_push_approval": false,
        "bypass_pull_request_allowances": {
          "users": [],
          "teams": [],
          "apps": []
        }
      },
      "restrictions": null,
      "required_linear_history": false,
      "allow_force_pushes": false,
      "allow_deletions": false,
      "block_creations": false,
      "required_conversation_resolution": false,
      "lock_branch": false,
      "allow_fork_syncing": false
    }
  }
}
